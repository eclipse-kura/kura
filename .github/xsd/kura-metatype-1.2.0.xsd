    Deviations from the published OSGi schema, all deliberate. Please read
    before "fixing" anything here:

    1. elementFormDefault="qualified" is added. The published schema omits it,
       which means its local element declarations land in NO namespace. Kura's
       hand-written metatypes declare a default xmlns and therefore put OCD/AD
       in the metatype namespace, so the published schema rejects every one of
       them with a misleading "Element 'OCD': This element is not expected".

    2. Every child element is declared twice, form="qualified" and
       form="unqualified". Both encodings occur in this repository and both are
       accepted by the Equinox metatype parser: files with a default xmlns put
       children in the metatype namespace, while files using an xmlns:metatype
       prefix (and everything bnd generates from @ObjectClassDefinition) leave
       children unqualified. The two declarations have distinct expanded names,
       so this does not violate Unique Particle Attribution.

    3. OCD content is a repeatable <choice> of AD and Icon rather than the
       spec's "AD+ then Icon*" sequence. Kura consistently places <Icon> first
       and has OCDs with no AD at all. Both are harmless in practice.

    4. The <any> extension wildcards are dropped. Nothing in this repository
       uses metatype extension elements, and they add non-determinism that
       libxml2 handles poorly.

    The reason this file exists at all is the <unique> constraint on OCD, which
    rejects duplicate AD ids within a single OCD. A duplicate silently shadows
    the earlier definition at runtime and is otherwise invisible until a
    configuration behaves unexpectedly in the field.

-->
<schema xmlns="http://www.w3.org/2001/XMLSchema"
    xmlns:metatype="http://www.osgi.org/xmlns/metatype/v1.2.0"
    targetNamespace="http://www.osgi.org/xmlns/metatype/v1.2.0"
    elementFormDefault="qualified"
    version="1.2.0-kura">

    <element name="MetaData" type="metatype:Tmetadata" />

    <complexType name="Tmetadata">
        <choice minOccurs="0" maxOccurs="unbounded">
            <element name="OCD" type="metatype:Tocd" form="qualified">
                <!-- AD ids must be unique within their own OCD. The selector
                     union covers both the qualified and the unqualified
                     encoding described in deviation 2 above. -->
                <unique name="uniqueAdIdQualified">
                    <selector xpath="metatype:AD|AD" />
                    <field xpath="@id" />
                </unique>
            </element>
            <element name="OCD" type="metatype:Tocd" form="unqualified">
                <unique name="uniqueAdIdUnqualified">
                    <selector xpath="metatype:AD|AD" />
                    <field xpath="@id" />
                </unique>
            </element>
            <element name="Designate" type="metatype:Tdesignate" form="qualified" />
            <element name="Designate" type="metatype:Tdesignate" form="unqualified" />
        </choice>
        <attribute name="localization" type="string" use="optional" />
        <anyAttribute processContents="lax" />
    </complexType>

    <complexType name="Tocd">
        <choice minOccurs="0" maxOccurs="unbounded">
            <element name="AD" type="metatype:Tad" form="qualified" />
            <element name="AD" type="metatype:Tad" form="unqualified" />
            <element name="Icon" type="metatype:Ticon" form="qualified" />
            <element name="Icon" type="metatype:Ticon" form="unqualified" />
        </choice>
        <attribute name="name" type="string" use="required" />
        <attribute name="description" type="string" use="optional" />
        <attribute name="id" type="string" use="required" />
        <anyAttribute processContents="lax" />
    </complexType>

    <complexType name="Tad">
        <choice minOccurs="0" maxOccurs="unbounded">
            <element name="Option" type="metatype:Toption" form="qualified" />
            <element name="Option" type="metatype:Toption" form="unqualified" />
        </choice>
        <attribute name="name" type="string" use="optional" />
        <attribute name="description" type="string" use="optional" />
        <attribute name="id" type="string" use="required" />
        <attribute name="type" type="metatype:Tscalar" use="required" />
        <attribute name="cardinality" type="int" use="optional" default="0" />
        <attribute name="min" type="string" use="optional" />
        <attribute name="max" type="string" use="optional" />
        <attribute name="default" type="string" use="optional" />
        <attribute name="required" type="boolean" use="optional" default="true" />
        <anyAttribute processContents="lax" />
    </complexType>

    <complexType name="Tdesignate">
        <!-- The spec allows exactly one Object; the choice exists only to
             accept either namespace encoding, not to relax the cardinality. -->
        <choice minOccurs="1" maxOccurs="1">
            <element name="Object" type="metatype:Tobject" form="qualified" />
            <element name="Object" type="metatype:Tobject" form="unqualified" />
        </choice>
        <attribute name="pid" type="string" use="optional" />
        <attribute name="factoryPid" type="string" use="optional" />
        <attribute name="bundle" type="string" use="optional" />
        <attribute name="optional" type="boolean" default="false" use="optional" />
        <attribute name="merge" type="boolean" default="false" use="optional" />
        <anyAttribute processContents="lax" />
    </complexType>

    <complexType name="Tobject">
        <choice minOccurs="0" maxOccurs="unbounded">
            <element name="Attribute" type="metatype:Tattribute" form="qualified" />
            <element name="Attribute" type="metatype:Tattribute" form="unqualified" />
        </choice>
        <attribute name="ocdref" type="string" use="required" />
        <anyAttribute processContents="lax" />
    </complexType>

    <complexType name="Tattribute">
        <choice minOccurs="0" maxOccurs="unbounded">
            <element name="Value" type="string" form="qualified" />
            <element name="Value" type="string" form="unqualified" />
        </choice>
        <attribute name="adref" type="string" use="required" />
        <attribute name="content" type="string" use="optional" />
        <anyAttribute processContents="lax" />
    </complexType>

    <simpleType name="Tscalar">
        <restriction base="string">
            <enumeration value="String" />
            <enumeration value="Long" />
            <enumeration value="Double" />
            <enumeration value="Float" />
            <enumeration value="Integer" />
            <enumeration value="Byte" />
            <enumeration value="Char" />
            <enumeration value="Boolean" />
            <enumeration value="Short" />
            <enumeration value="Password" />
        </restriction>
    </simpleType>

    <complexType name="Toption">
        <attribute name="label" type="string" use="required" />
        <attribute name="value" type="string" use="required" />
        <anyAttribute processContents="lax" />
    </complexType>

    <complexType name="Ticon">
        <attribute name="resource" type="string" use="required" />
        <attribute name="size" type="positiveInteger" use="required" />
        <anyAttribute processContents="lax" />
    </complexType>

</schema>
