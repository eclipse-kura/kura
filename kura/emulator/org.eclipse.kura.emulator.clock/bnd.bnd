Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Name: org.eclipse.kura.emulator.clock
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
Import-Package: \
    org.eclipse.kura;version="[1.0,2.0)",\
    org.eclipse.kura.clock;version="[1.0,1.1)",\
    org.eclipse.kura.configuration;version="[1.1,2.0)",\
    org.osgi.service.component;version="1.2.0",\
    org.osgi.service.event;version="1.3.0",\
    org.slf4j;version="1.6.4",\
    *
Export-Package: \
    org.eclipse.kura.emulator.clock; version="1.0.0"
-includeresource: \
    about.html,\
    about_files=about_files/
