Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Name: org.eclipse.kura.emulator
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
Import-Package: \
    org.apache.commons.io;version="2.4.0",\
    org.apache.commons.lang3;version="3.4.0",\
    org.osgi.framework;version="1.7.0",\
    org.osgi.service.component;version="1.2.0",\
    org.slf4j;version="1.7.25",\
    *
Export-Package: \
    org.eclipse.kura.emulator; version="1.0.0"
-includeresource: \
    about.html,\
    about_files=about_files/
