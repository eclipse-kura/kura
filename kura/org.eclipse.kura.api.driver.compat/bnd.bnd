Bundle-SymbolicName: ${project.artifactId}
Bundle-Name: org.eclipse.kura.api.driver.compat
Bundle-Vendor: Eclipse Kura
Fragment-Host: org.eclipse.kura.api;bundle-version="[3.0.0,4.0.0)"
Export-Package: \
    org.eclipse.kura.driver;version="1.0.0",\
    org.eclipse.kura.gpio;version="1.2.0"
-includeresource: \
    about.html,\
    about_files=about_files/
-fixupmessages: \
    "Classpath is empty*";is:=ignore,\
    "Host org.eclipse.kura.api*cannot be found on the classpath";is:=ignore
