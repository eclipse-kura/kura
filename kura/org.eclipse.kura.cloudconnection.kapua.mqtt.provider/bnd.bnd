Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Name: org.eclipse.kura.cloudconnection.kapua.mqtt.provider
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .,lib/protobuf-java.jar
-includeresource: \
    about.html,\
    about_files=about_files/,\
    lib/protobuf-java.jar

# Pick up test components contributed by the attached test fragment, if any
Service-Component: OSGI-INF/test-*.xml
