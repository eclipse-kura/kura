Bundle-SymbolicName: ${project.artifactId}
Bundle-Name: Sparkplug MQTT Cloud Connection Provider
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .,lib/org.eclipse.paho.client.mqttv3-1.2.1.k2.jar
-includeresource: \
    about.html,\
    lib=lib,\
    about_files=about_files/
Import-Package: \
    com.google.gson;version="[2.7,3.0)",\
    com.google.protobuf;version="4.30.2",\
    org.eclipse.kura;version="[1.0,2.0)",\
    org.eclipse.kura.cloud;version="[1.1,2.0)",\
    org.eclipse.kura.cloudconnection;version="[1.0,1.1)",\
    org.eclipse.kura.cloudconnection.factory;version="[1.0,1.1)",\
    org.eclipse.kura.cloudconnection.listener;version="[1.0,2.0)",\
    org.eclipse.kura.cloudconnection.message;version="[1.0,2.0)",\
    org.eclipse.kura.cloudconnection.publisher;version="[1.0,1.1)",\
    org.eclipse.kura.cloudconnection.subscriber;version="[1.0,1.1)",\
    org.eclipse.kura.cloudconnection.subscriber.listener;version="[1.0,2.0)",\
    org.eclipse.kura.configuration;version="[1.2,2.0)",\
    org.eclipse.kura.crypto;version="[1.3,2.0)",\
    org.eclipse.kura.data;version="[1.0,2.0)",\
    org.eclipse.kura.data.listener;version="[1.0,2.0)",\
    org.eclipse.kura.data.transport.listener;version="[1.0,2.0)",\
    org.eclipse.kura.message;version="[1.4,2.0)",\
    org.eclipse.kura.ssl;version="[2.1,3.0)",\
    org.osgi.framework;version="1.8.0",\
    org.osgi.service.component;version="1.2.0",\
    org.osgi.service.event;version="1.3.1",\
    org.osgi.util.tracker;version="[1.5,2.0)",\
    org.slf4j;version="1.7.36",\
    javax.net,\
    *
Export-Package: \
    org.eclipse.kura.cloudconnection.sparkplug.mqtt.device;version="2.0.0";x-internal:=true,\
    org.eclipse.kura.cloudconnection.sparkplug.mqtt.endpoint;version="2.0.0";x-internal:=true,\
    org.eclipse.kura.cloudconnection.sparkplug.mqtt.factory;version="2.0.0";x-internal:=true,\
    org.eclipse.kura.cloudconnection.sparkplug.mqtt.message;version="2.0.0";x-internal:=true,\
    org.eclipse.kura.cloudconnection.sparkplug.mqtt.subscriber;version="2.0.0";x-internal:=true,\
    org.eclipse.kura.cloudconnection.sparkplug.mqtt.transport;version="2.0.0";x-internal:=true,\
    org.eclipse.tahu.protobuf;version="2.0.0";x-internal:=true

# Pick up DS components contributed by the attached whitebox test fragment, if any.
# bnd merges this with the components it generates from this bundle's @Component annotations.
Service-Component: OSGI-INF/test-*.xml
