Bundle-SymbolicName: ${project.artifactId};singleton:=true
Import-Package: \
    com.google.gson;version="2.7.0",\
    org.eclipse.kura;version="[1.7,2.0)",\
    org.eclipse.kura.cloudconnection.message;version="[1.0,2.0)",\
    org.eclipse.kura.cloudconnection.publisher;version="[1.0,2.0)",\
    org.eclipse.kura.configuration;version="[1.2,1.3)",\
    org.eclipse.kura.message;version="[1.4,2.0)",\
    org.osgi.framework;version="1.7.0",\
    org.osgi.util.tracker;version="[1.5,2.0)",\
    org.slf4j;version="1.6.4",\
    *
Bundle-Name: org.eclipse.kura.configuration.change.manager
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
-includeresource: \
    OSGI-INF=OSGI-INF,\
    about.html,\
    about_files=about_files/
