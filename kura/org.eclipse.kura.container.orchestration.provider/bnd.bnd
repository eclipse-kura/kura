Bundle-SymbolicName: ${project.artifactId}
Import-Package: \
    com.google.common.collect;version="32.1.1",\
    org.eclipse.kura;version="[1.6,2.0)",\
    org.eclipse.kura.configuration;version="[1.2,2.0)",\
    org.eclipse.kura.container.orchestration;version="[1.3,2.0)",\
    org.eclipse.kura.container.orchestration.listener;version="[1.0,1.1)",\
    org.eclipse.kura.crypto;version="[1.3,2.0]",\
    org.eclipse.kura.util.configuration;version="[1.0,2.0)",\
    org.slf4j;version="1.7.25",\
    *
Bundle-Name: Configurable container management component
Bundle-Vendor: Eclipse Kura
Bundle-ClassPath: .,lib/commons-codec.jar,lib/commons-compress.jar,lib/docker-java-api.jar,lib/docker-java-core.jar,lib/docker-java-transport.jar,lib/docker-java-transport-httpclient5.jar,lib/httpclient5.jar,lib/httpcore5.jar,lib/httpcore5-h2.jar,lib/jna.jar
-includeresource: \
    lib/commons-codec.jar,\
    lib/commons-compress.jar,\
    lib/docker-java-api.jar,\
    lib/docker-java-core.jar,\
    lib/docker-java-transport.jar,\
    lib/docker-java-transport-httpclient5.jar,\
    lib/httpclient5.jar,\
    lib/httpcore5.jar,\
    lib/httpcore5-h2.jar,\
    lib/jna.jar,\
    about.html,\
    about_files=about_files/
