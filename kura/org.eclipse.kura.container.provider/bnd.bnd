Bundle-SymbolicName: ${project.artifactId};singleton:=true
Import-Package: \
    org.eclipse.kura;version="[1.3,2.0)",\
    org.eclipse.kura.configuration;version="[1.2,1.3)",\
    org.eclipse.kura.container.orchestration;version="[1.2,2.0)",\
    org.eclipse.kura.container.orchestration.listener;version="[1.0,1.1)",\
    org.eclipse.kura.container.signature;version="[1.0,2.0)",\
    org.eclipse.kura.identity;version="[1.2,2.0)",\
    org.eclipse.kura.net;version="[2.0,3.0)",\
    org.eclipse.kura.util.configuration;version="[1.0,2.0)",\
    org.slf4j;version="1.7.25",\
    *
Bundle-Name: Configurable custom container service
Bundle-Vendor: EUROTECH
Bundle-ActivationPolicy: lazy
-includeresource: \
    about.html,\
    about_files=about_files/
