Bundle-SymbolicName: ${project.artifactId};singleton:=true
Import-Package: \
    javax.comm;version="1.2.0",\
    javax.microedition.io,\
    org.eclipse.kura;version="[1.0,2.0)",\
    org.eclipse.kura.comm;version="[1.1,1.2)",\
    org.osgi.service.io;version="1.0.0",\
    *
Bundle-Name: org.eclipse.kura.core.comm
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
-includeresource: \
    about.html,\
    about_files=about_files/
