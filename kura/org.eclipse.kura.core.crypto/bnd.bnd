Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Name: org.eclipse.kura.core.crypto
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
Import-Package: \
    javax.crypto,\
    javax.crypto.spec,\
    org.eclipse.kura;version="[1.0,2.0)",\
    org.eclipse.kura.crypto;version="[1.4,1.5)",\
    org.eclipse.kura.system;version="[1.1,2.0)",\
    org.slf4j;version="1.6.0",\
    *
Export-Package: \
    org.eclipse.kura.core.crypto
-includeresource: \
    about_files=about_files/,\
    about.html
