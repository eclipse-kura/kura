Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Name: org.eclipse.kura.core.keystore
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
# sun.security.pkcs11 is a JDK-internal package used only by the optional
# PKCS11KeystoreServiceImpl. It is not exported by any bundle nor by the
# framework system packages, so a mandatory import (bnd's default) leaves the
# whole bundle UNRESOLVED at runtime -> its DS components (incl. the Filesystem
# keystore used for HTTPS) never activate. Make it optional so the bundle
# resolves; PKCS11 support still works where the JVM package is boot-delegated.
Import-Package: \
    sun.security.pkcs11;resolution:=optional,\
    com.eclipsesource.json;version="0.9.5",\
    javax.net.ssl,\
    javax.security.auth.x500,\
    org.bouncycastle.asn1;version="1.78.1",\
    org.bouncycastle.asn1.pkcs;version="1.78.1",\
    org.bouncycastle.asn1.x500;version="1.78.1",\
    org.bouncycastle.asn1.x509;version="1.78.1",\
    org.bouncycastle.asn1.x9;version="1.78.1",\
    org.bouncycastle.cert;version="1.78.1",\
    org.bouncycastle.cert.jcajce;version="1.78.1",\
    org.bouncycastle.jce.provider;version="1.78.1",\
    org.bouncycastle.openssl;version="1.78.1",\
    org.bouncycastle.openssl.bc;version="1.78.1",\
    org.bouncycastle.openssl.jcajce;version="1.78.1",\
    org.bouncycastle.operator;version="1.78.1",\
    org.bouncycastle.operator.jcajce;version="1.78.1",\
    org.bouncycastle.pkcs;version="1.78.1",\
    org.bouncycastle.pkcs.jcajce;version="1.78.1",\
    org.bouncycastle.util;version="1.78.1",\
    org.bouncycastle.util.io.pem;version="1.78.1",\
    org.eclipse.kura;version="[1.6,2.0)",\
    org.eclipse.kura.configuration;version="[1.2,2.0)",\
    org.eclipse.kura.crypto;version="[1.1,2.0)",\
    org.eclipse.kura.security.keystore;version="[1.2,1.3)",\
    org.eclipse.kura.system;version="[1.5,2.0)",\
    org.eclipse.kura.util.configuration;version="[1.0,2.0)",\
    org.osgi.framework;version="1.10.0",\
    org.osgi.service.component;version="1.2.0",\
    org.osgi.service.event;version="1.4.0",\
    org.slf4j;version="1.7.32",\
    *
Export-Package: \
    org.eclipse.kura.core.keystore.util;version="1.1.0"
-includeresource: \
    about_files=about_files/,\
    about.html
-dsannotations-options: inherit
