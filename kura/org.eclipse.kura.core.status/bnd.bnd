Bundle-SymbolicName: ${project.artifactId};singleton:=true
Import-Package: \
    org.eclipse.kura;version="[1.3,2.0)",\
    org.eclipse.kura.gpio;version="[1.0,2.0)",\
    org.eclipse.kura.status;version="[1.0,1.1)",\
    org.eclipse.kura.system;version="[1.0,2.0)",\
    org.osgi.service.component;version="1.2.0",\
    org.slf4j;version="1.6.4",\
    *
Bundle-Name: org.eclipse.kura.core.status
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
-includeresource: \
    about.html,\
    about_files=about_files/
