Bundle-SymbolicName: ${project.artifactId};singleton:=true
Import-Package: \
    org.apache.commons.io;version="[2.4,3.0)",\
    org.eclipse.kura;version="[1.0,2.0)",\
    org.eclipse.kura.executor;version="[1.0,2.0)",\
    org.eclipse.kura.net;version="[2.0,3.0)",\
    org.eclipse.kura.system;version="[1.9,2.0)",\
    org.osgi.framework;version="1.5.0",\
    org.osgi.service.component;version="1.2.0",\
    org.slf4j;version="1.6.4",\
    *
Bundle-Name: org.eclipse.kura.core.system
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
-includeresource: \
    about.html,\
    about_files=about_files/

# Pick up test components contributed by the attached test fragment, if any
Service-Component: OSGI-INF/test-*.xml
