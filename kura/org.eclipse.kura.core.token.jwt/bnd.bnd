Bundle-Name: ${project.artifactId}
Bundle-SymbolicName: ${project.artifactId};singleton:=true
Import-Package: \
    com.fasterxml.jackson.annotation;version="[2.19,3.0)",\
    com.fasterxml.jackson.core;version="[2.19,3.0)",\
    com.fasterxml.jackson.core.type;version="[2.19,3.0)",\
    com.fasterxml.jackson.databind;version="[2.19,3.0)",\
    com.fasterxml.jackson.databind.deser.std;version="[2.19,3.0)",\
    com.fasterxml.jackson.databind.json;version="[2.19,3.0)",\
    com.fasterxml.jackson.databind.module;version="[2.19,3.0)",\
    com.fasterxml.jackson.databind.ser.std;version="[2.19,3.0)",\
    org.eclipse.kura;version="[1.8,2.0)",\
    org.eclipse.kura.configuration;version="[1.2,2.0)",\
    org.eclipse.kura.security.keystore;version="[1.2,2.0)",\
    org.eclipse.kura.security.token;version="[1.0,1.1)",\
    org.osgi.service.event;version="[1.3,2.0)",\
    org.slf4j;version="1.7.36",\
    *
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .,\
    java-jwt.jar
-includeresource: \
    about.html,\
    about_files=about_files/,\
    lib/java-jwt.jar

Service-Component: OSGI-INF/*.xml
