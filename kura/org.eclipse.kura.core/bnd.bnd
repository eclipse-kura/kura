Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Name: org.eclipse.kura.core
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
Import-Package: \
    javax.naming,\
    javax.net.ssl,\
    org.apache.commons.exec;version="1.3.0",\
    org.apache.commons.exec.environment;version="1.3.0",\
    org.apache.commons.exec.util;version="1.3.0",\
    org.apache.commons.io;version="[2.4,3.0)",\
    org.apache.commons.io.output;version="2.4.0",\
    org.eclipse.kura;version="[1.0,2.0)",\
    org.eclipse.kura.configuration;version="[1.1,2.0)",\
    org.eclipse.kura.core.ssl;version="1.0.0",\
    org.eclipse.kura.executor;version="[1.0,2.0)",\
    org.eclipse.kura.security.keystore;version="[1.0,2.0)",\
    org.eclipse.kura.ssl;version="[2.1,2.2)",\
    org.eclipse.kura.system;version="[1.4,2.0)",\
    org.eclipse.kura.util.configuration;version="[1.0,2.0)",\
    org.osgi.framework;version="1.5.0",\
    org.osgi.service.component;version="1.2.0",\
    org.osgi.service.event;version="1.4.0",\
    org.osgi.util.tracker;version="1.5.0",\
    org.slf4j;version="1.6.4",\
    *
Export-Package: \
    org.eclipse.kura.core.linux.executor;version="1.0.0",\
    org.eclipse.kura.core.linux.util;version="1.2.0",\
    org.eclipse.kura.core.ssl;version="1.0.0",\
    org.eclipse.kura.core.util;version="2.0.0";x-internal:=true
-includeresource: \
    about.html,\
    about_files=about_files/

Service-Component: OSGI-INF/*.xml
