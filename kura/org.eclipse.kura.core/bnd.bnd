Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Name: org.eclipse.kura.core
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
Export-Package: \
    org.eclipse.kura.core.linux.executor;version="2.0.0",\
    org.eclipse.kura.core.linux.util;version="2.0.0",\
    org.eclipse.kura.core.ssl;version="2.0.0",\
    org.eclipse.kura.core.util;version="2.0.0";x-internal:=true
-includeresource: \
    about.html,\
    about_files=about_files/

# Pick up test components contributed by the attached test fragment, if any
Service-Component: OSGI-INF/test-*.xml
