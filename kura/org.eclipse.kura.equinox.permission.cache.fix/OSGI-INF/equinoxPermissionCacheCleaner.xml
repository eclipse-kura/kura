<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.3.0"
    configuration-policy="optional"
    enabled="true"
    immediate="true"
    activate="activate"
    deactivate="deactivate"
    name="equinoxPermissionCacheCleaner">
    
    <reference name="PermissionAdmin"
        interface="org.osgi.service.permissionadmin.PermissionAdmin"
        bind="setPermissionAdmin"
    />

    <implementation class="org.eclipse.kura.equinox.permission.cache.fix.EquinoxPermissionCacheCleaner" />

    <property name="cache.threshold.size" type="Integer" value="10000" />
</scr:component>