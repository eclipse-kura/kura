Bundle-SymbolicName: ${project.artifactId}
Import-Package: \
    jakarta.servlet;version="5.0.0",\
    jakarta.servlet.http;version="5.0.0",\
    org.eclipse.jetty.ee10.servlet;version="12.0.14",\
    org.eclipse.jetty.http;version="12.0.14",\
    org.eclipse.jetty.server;version="12.0.14",\
    org.eclipse.jetty.server.handler;version="12.0.14",\
    org.eclipse.jetty.server.handler.gzip;version="12.0.14",\
    org.eclipse.jetty.session;version="12.0.14",\
    org.eclipse.jetty.util.compression;version="12.0.14",\
    org.eclipse.jetty.util.ssl;version="12.0.14",\
    org.eclipse.jetty.util.thread;version="12.0.14",\
    org.eclipse.kura;version="[1.5,2.0)",\
    org.eclipse.kura.configuration;version="1.2.0",\
    org.eclipse.kura.security.keystore;version="[1.0,2.0)",\
    org.eclipse.kura.util.configuration;version="[1.0,2.0)",\
    org.osgi.framework;version="1.8.0",\
    org.osgi.service.event;version="1.4.0",\
    org.slf4j;version="1.7.21",\
    javax.net.ssl,\
    *
Bundle-Name: org.eclipse.kura.http.server.manager
Require-Bundle: org.apache.felix.http.bridge;bundle-version="5.1.8"
-includeresource: \
    about.html,\
    about_files=about_files/
