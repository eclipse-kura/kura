Bundle-SymbolicName: ${project.artifactId};singleton:=true
Import-Package: \
    org.osgi.framework;version="1.10.0",\
    org.slf4j.bridge;version="1.7.21",\
    *
Bundle-Name: Kura Configurator for jul-to-slf4j
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
Bundle-Activator: org.eclipse.kura.jul.to.slf4j.configuration.Activator

-includeresource: \
    about.html,\
    about_files=about_files/
