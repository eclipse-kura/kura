Bundle-SymbolicName: ${project.artifactId};singleton:=true
Import-Package: \
    org.eclipse.kura;version="[1.3,2.0)",\
    org.eclipse.kura.configuration;version="[1.1,2.0)",\
    org.eclipse.kura.watchdog;version="[1.0,1.1)",\
    org.slf4j;version="1.6.4",\
    *
Bundle-Name: org.eclipse.kura.linux.watchdog
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
-includeresource: \
    about.html,\
    about_files=about_files/
