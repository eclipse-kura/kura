<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.eclipse.kura</groupId>
    <artifactId>kura</artifactId>
    <version>5.6.1-SNAPSHOT</version>
  </parent>
  <artifactId>org.eclipse.kura.nm</artifactId>
  <version>1.3.1-SNAPSHOT</version>
  <packaging>eclipse-plugin</packaging>
  <properties>
    <kura.basedir>${project.basedir}/..</kura.basedir>
    <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/../test/org.eclipse.kura.nm.test/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.kura</groupId>
      <artifactId>org.eclipse.kura.api</artifactId>
      <version>2.8.1-SNAPSHOT</version>
      <scope>compile</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.eclipse.kura</groupId>
      <artifactId>org.eclipse.kura.core</artifactId>
      <version>1.6.1-SNAPSHOT</version>
      <scope>compile</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.eclipse.kura</groupId>
      <artifactId>org.eclipse.kura.util</artifactId>
      <version>1.7.1-SNAPSHOT</version>
      <scope>compile</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.eclipse.kura</groupId>
      <artifactId>org.eclipse.kura.core.configuration</artifactId>
      <version>2.6.1-SNAPSHOT</version>
      <scope>compile</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.eclipse.kura</groupId>
      <artifactId>org.eclipse.kura.core.keystore</artifactId>
      <version>1.6.1-SNAPSHOT</version>
      <scope>compile</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.eclipse.kura</groupId>
      <artifactId>org.eclipse.kura.request.handler.jaxrs</artifactId>
      <version>1.5.1-SNAPSHOT</version>
      <scope>compile</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.eclipse.kura</groupId>
      <artifactId>org.eclipse.kura.rest.provider</artifactId>
      <version>1.7.1-SNAPSHOT</version>
      <scope>compile</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.eclipse.kura</groupId>
      <artifactId>org.eclipse.kura.core.net</artifactId>
      <version>1.6.1-SNAPSHOT</version>
      <scope>compile</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.eclipse.kura</groupId>
      <artifactId>org.eclipse.kura.net.configuration</artifactId>
      <version>1.3.1-SNAPSHOT</version>
      <scope>compile</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.eclipse.kura</groupId>
      <artifactId>org.eclipse.kura.deployment.agent</artifactId>
      <version>1.6.1-SNAPSHOT</version>
      <scope>compile</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.eclipse.kura</groupId>
      <artifactId>org.eclipse.kura.linux.net</artifactId>
      <version>2.6.1-SNAPSHOT</version>
      <scope>compile</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.eclipse.kura</groupId>
      <artifactId>org.eclipse.kura.linux.position</artifactId>
      <version>1.6.1-SNAPSHOT</version>
      <scope>compile</scope>
      <optional>false</optional>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.0.0</version>
        <executions>
          <execution>
            <phase>generate-sources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.basedir}/lib</outputDirectory>
              <stripVersion>false</stripVersion>
              <artifactItems>
                <artifactItem>
                  <groupId>com.github.hypfvieh</groupId>
                  <artifactId>dbus-java</artifactId>
                  <version>3.3.2</version>
                </artifactItem>
                <artifactItem>
                  <groupId>com.github.jnr</groupId>
                  <artifactId>jnr-unixsocket</artifactId>
                  <version>0.38.17</version>
                </artifactItem>
                <artifactItem>
                  <groupId>com.github.jnr</groupId>
                  <artifactId>jnr-ffi</artifactId>
                  <version>2.2.11</version>
                </artifactItem>
                <artifactItem>
                  <groupId>com.github.jnr</groupId>
                  <artifactId>jnr-constants</artifactId>
                  <version>0.10.3</version>
                </artifactItem>
                <artifactItem>
                  <groupId>com.github.jnr</groupId>
                  <artifactId>jnr-enxio</artifactId>
                  <version>0.32.13</version>
                </artifactItem>
                <artifactItem>
                  <groupId>com.github.jnr</groupId>
                  <artifactId>jnr-posix</artifactId>
                  <version>3.1.15</version>
                </artifactItem>
                <artifactItem>
                  <groupId>com.github.jnr</groupId>
                  <artifactId>jnr-a64asm</artifactId>
                  <version>1.0.0</version>
                </artifactItem>
                <artifactItem>
                  <groupId>com.github.jnr</groupId>
                  <artifactId>jnr-x86asm</artifactId>
                  <version>1.0.2</version>
                </artifactItem>
                <artifactItem>
                  <groupId>com.github.jnr</groupId>
                  <artifactId>jffi</artifactId>
                  <version>1.3.9</version>
                </artifactItem>
                <artifactItem>
                  <groupId>org.ow2.asm</groupId>
                  <artifactId>asm</artifactId>
                  <version>9.2</version>
                </artifactItem>
                <artifactItem>
                  <groupId>org.ow2.asm</groupId>
                  <artifactId>asm-analysis</artifactId>
                  <version>9.2</version>
                </artifactItem>
                <artifactItem>
                  <groupId>org.ow2.asm</groupId>
                  <artifactId>asm-commons</artifactId>
                  <version>9.2</version>
                </artifactItem>
                <artifactItem>
                  <groupId>org.ow2.asm</groupId>
                  <artifactId>asm-tree</artifactId>
                  <version>9.2</version>
                </artifactItem>
                <artifactItem>
                  <groupId>org.ow2.asm</groupId>
                  <artifactId>asm-util</artifactId>
                  <version>9.2</version>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
