Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Name: org.eclipse.kura.request.handler.jaxrs
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
Export-Package: \
    org.eclipse.kura.request.handler.jaxrs;version="2.0.0",\
    org.eclipse.kura.request.handler.jaxrs.annotation;version="2.0.0",\
    org.eclipse.kura.request.handler.jaxrs.consumer;version="2.0.0"
-includeresource: \
    about.html,\
    about_files=about_files/
