Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Name: CloudConnection REST Service
Bundle-ActivationPolicy: lazy
-includeresource: \
    about.html,\
    about_files=about_files/
Import-Package: \
    jakarta.annotation.security;version="2.1.1",\
    jakarta.ws.rs;version="3.1.0",\
    jakarta.ws.rs.core;version="3.1.0",\
    org.eclipse.kura;version="[1.3,2.0)",\
    org.eclipse.kura.cloud;version="[1.1,2.0)",\
    org.eclipse.kura.cloud.factory;version="[1.1.1,2.0)",\
    org.eclipse.kura.cloudconnection;version="[1.0,2.0)",\
    org.eclipse.kura.cloudconnection.factory;version="[1.0,2.0)",\
    org.eclipse.kura.cloudconnection.publisher;version="[1.0,2.0)",\
    org.eclipse.kura.cloudconnection.request;version="[1.0,2.0)",\
    org.eclipse.kura.cloudconnection.subscriber;version="[1.0,2.0)",\
    org.eclipse.kura.configuration;version="[1.2,2.0)",\
    org.eclipse.kura.core.configuration;version="[2.0,3.0)",\
    org.eclipse.kura.crypto;version="1.3.0",\
    org.eclipse.kura.data;version="[1.1.2,2.0)",\
    org.eclipse.kura.request.handler.jaxrs;version="[2.0,3.0)",\
    org.eclipse.kura.rest.configuration.api;version="[1.1,2.0)",\
    org.eclipse.kura.util.service;version="[1.2,2.0)",\
    org.osgi.framework;version="1.8.0",\
    org.osgi.service.component.runtime;version="1.4.0",\
    org.osgi.service.component.runtime.dto;version="1.4.0",\
    org.osgi.service.useradmin;version="1.1.0",\
    org.slf4j;version="1.7.25",\
    *
Export-Package: \
    org.eclipse.kura.internal.rest.cloudconnection.provider.dto;version="2.0.0";x-internal:=true
