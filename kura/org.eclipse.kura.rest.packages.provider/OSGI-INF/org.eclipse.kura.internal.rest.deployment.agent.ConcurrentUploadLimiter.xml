<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.1.0" name="org.eclipse.kura.rest.deployment.agent.ConcurrentUploadLimiter">
   <implementation class="org.eclipse.kura.internal.rest.deployment.agent.ConcurrentUploadLimiter"/>
   <property name="kura.service.pid" type="String" value="org.eclipse.kura.rest.deployment.agent.ConcurrentUploadLimiter"/>
   <property name="event.topics" type="String" value="org/eclipse/kura/deployment/agent/INSTALLED"/>
   <service>
      <provide interface="org.eclipse.kura.internal.rest.deployment.agent.ConcurrentUploadLimiter"/>
      <provide interface="javax.ws.rs.container.ContainerRequestFilter"/>
      <provide interface="javax.ws.rs.container.ContainerResponseFilter"/>
      <provide interface="org.osgi.service.event.EventHandler"/>
   </service>
   <reference name="DeploymentAgentService"
       cardinality="1..1"
       interface="org.eclipse.kura.deployment.agent.DeploymentAgentService"
       bind="setDeploymentAgentService"
       policy="static"/>
</scr:component>
