<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.1.0" name="org.eclipse.kura.rest.deployment.agent.MultipartRequestBodySizeLimiter">
   <implementation class="org.eclipse.kura.internal.rest.deployment.agent.MultipartRequestBodySizeLimiter"/>
   <property name="kura.service.pid" type="String" value="org.eclipse.kura.rest.deployment.agent.MultipartRequestBodySizeLimiter"/>
   <service>
      <provide interface="javax.ws.rs.container.ContainerRequestFilter"/>
      <provide interface="javax.ws.rs.container.ContainerResponseFilter"/>
   </service>
   <reference name="SystemService"
       cardinality="1..1"
       interface="org.eclipse.kura.system.SystemService"
       bind="setSystemService"
       policy="static"/>
</scr:component>
