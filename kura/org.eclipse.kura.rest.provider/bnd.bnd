Bundle-SymbolicName: ${project.artifactId}
Bundle-Name: Kura Rest Provider
Bundle-ActivationPolicy: lazy
Require-Bundle: org.eclipse.osgitech.rest.servlet.whiteboard;bundle-version="1.2.3"
Import-Package: \
    com.google.gson;version="2.9.0",\
    jakarta.annotation;version="2.1.1",\
    jakarta.annotation.security;version="2.1.1",\
    jakarta.servlet.http;version="5.0.0",\
    jakarta.ws.rs;version="3.1.0",\
    jakarta.ws.rs.container;version="3.1.0",\
    jakarta.ws.rs.core;version="3.1.0",\
    jakarta.ws.rs.ext;version="3.1.0",\
    org.eclipse.kura;version="[1.3,2.0)",\
    org.eclipse.kura.audit;version="[1.0,2.0)",\
    org.eclipse.kura.configuration;version="[1.2,2.0)",\
    org.eclipse.kura.identity;version="[1.1,2.0)",\
    org.eclipse.kura.request.handler.jaxrs;version="[2.0,3.0)",\
    org.eclipse.kura.util.configuration;version="[1.0,2.0)",\
    org.eclipse.kura.util.validation;version="[1.0,2.0)",\
    org.osgi.framework;version="1.10.0",\
    org.osgi.service.cm;version="1.6.0",\
    org.slf4j;version="1.7.21",\
    javax.naming.ldap,\
    *
Export-Package: \
    org.eclipse.kura.rest.auth;version="1.0.0",\
    org.eclipse.kura.rest.utils;version="1.0.0"
-includeresource: \
    about.html,\
    about_files=about_files/
