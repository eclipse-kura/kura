Bundle-SymbolicName: ${project.artifactId}
Bundle-Name: Kura Rest Provider
Bundle-ActivationPolicy: lazy
Require-Bundle: org.eclipse.osgitech.rest.servlet.whiteboard;bundle-version="1.2.3"
Export-Package: \
    org.eclipse.kura.rest.auth;version="2.0.0",\
    org.eclipse.kura.rest.utils;version="2.0.0"
-includeresource: \
    OSGI-INF=OSGI-INF,\
    about.html,\
    about_files=about_files/
