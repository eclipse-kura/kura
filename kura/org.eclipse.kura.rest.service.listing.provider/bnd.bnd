Bundle-SymbolicName: ${project.artifactId};singleton:=true
Import-Package: \
    jakarta.ws.rs;version="3.1.0",\
    jakarta.ws.rs.container;version="3.1.0",\
    jakarta.ws.rs.core;version="3.1.0",\
    org.eclipse.kura;version="[1.3,2.0)",\
    org.eclipse.kura.cloudconnection.request;version="[1.0,2.0)",\
    org.eclipse.kura.configuration;version="[1.1,2.0)",\
    org.eclipse.kura.request.handler.jaxrs;version="[2.0,3.0)",\
    org.eclipse.kura.rest.configuration.api;version="[1.0,2.0)",\
    org.osgi.framework;version="1.8.0",\
    org.osgi.service.component;version="1.4.0",\
    org.osgi.service.component.runtime;version="1.4.0",\
    org.osgi.service.component.runtime.dto;version="1.4.0",\
    org.slf4j;version="1.7.25",\
    *
Bundle-Name: Services REST Service
Bundle-ActivationPolicy: lazy
-includeresource: \
    about.html,\
    about_files=about_files/
