Bundle-SymbolicName: ${project.artifactId};singleton:=true
Import-Package: \
    com.eclipsesource.json;version="0.9.0",\
    org.apache.felix.useradmin;version="[1.0,1.1)",\
    org.eclipse.kura.configuration;version="1.2.0",\
    org.eclipse.kura.util.configuration;version="1.0.0",\
    org.osgi.framework;version="1.8.0",\
    org.osgi.service.useradmin;version="[1.1,1.2)",\
    org.slf4j;version="1.7.25",\
    *
Bundle-Name: Kura Asset Accessor Provider
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
-includeresource: \
    about.html,\
    about_files=about_files/
