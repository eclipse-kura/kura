    org.eclipse.kura.util.message.store;version="2.0.0";x-internal:=true,\
    org.eclipse.kura.util.osgi;version="2.0.0",\
    org.eclipse.kura.util.service;version="2.0.0",\
    org.eclipse.kura.util.store.listener;version="2.0.0";x-internal:=true,\
    org.eclipse.kura.util.useradmin;version="2.0.0";x-internal:=true,\
    org.eclipse.kura.util.validation;version="2.0.0";x-internal:=true,\
    org.eclipse.kura.util.wire.store;version="2.0.0";x-internal:=true,\
    org.eclipse.kura.util.zip;version="2.0.0"
