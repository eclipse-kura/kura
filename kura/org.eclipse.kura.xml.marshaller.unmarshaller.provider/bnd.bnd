Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Name: Kura XML Marshaller utility
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
Import-Package: \
    javax.xml.parsers,\
    javax.xml.stream,\
    javax.xml.transform,\
    javax.xml.transform.dom,\
    javax.xml.transform.stream,\
    org.apache.commons.io.build;version="[2.18,3.0)",\
    org.apache.commons.io.input;version="[2.18,3.0)",\
    org.eclipse.kura;version="[1.4,2.0)",\
    org.eclipse.kura.configuration;version="[1.1,2.0)",\
    org.eclipse.kura.configuration.metatype;version="[1.1,2.0)",\
    org.eclipse.kura.core.configuration;version="[2.0,3.0)",\
    org.eclipse.kura.core.configuration.metatype;version="[1.0,2.0)",\
    org.eclipse.kura.core.inventory.resources;version="[1.0,2.0)",\
    org.eclipse.kura.marshalling;version="[1.1,1.2)",\
    org.eclipse.kura.system;version="[1.5,2.0)",\
    org.slf4j;version="1.7.21",\
    org.w3c.dom,\
    org.xml.sax,\
    *
Export-Package: \
    org.eclipse.kura.internal.xml.marshaller.unmarshaller;version="1.1.0"
-includeresource: \
    about.html,\
    about_files=about_files/
