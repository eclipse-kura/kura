<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.eclipse.kura</groupId>
	<artifactId>target-definition-resources</artifactId>
	<version>6.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>


	<build>
		<resources>
			<resource>
				<directory>resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>generic-target.target</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<!-- 2. Filter the .target file using the merged properties -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>filter-target-file</id>
						<phase>initialize</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<encoding>UTF-8</encoding>
							<outputDirectory>
								${project.basedir}/../kura-target-definition</outputDirectory>
							<resources>
								<resource>
									<directory>
										${project.basedir}</directory>
									<includes>
										<include>generic-target.target</include>
									</includes>
									<filtering>true</filtering>
								</resource>
							</resources>
							<filters>
								<filter>
									${project.basedir}/merged.properties</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>replace-target-file</id>
						<phase>generate-resources</phase>
						<configuration>
							<target>
								<move
									file="../kura-target-definition/generic-target.target"
									tofile="../kura-target-definition/kura-target-definition.target" />
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
