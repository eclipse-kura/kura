Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Name: org.eclipse.kura.test
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
Import-Package: \
    org.eclipse.kura;version="[1.0,2.0)",\
    org.eclipse.kura.cloud;version="[1.0,2.0)",\
    org.eclipse.kura.message;version="[1.0,2.0)",\
    org.eclipse.kura.system;version="[1.0,2.0)",\
    org.eclipse.osgi.framework.console;version="1.1.0",\
    org.junit,\
    org.osgi.framework;version="1.5.0",\
    org.osgi.service.cm;version="1.4.0",\
    org.osgi.service.component;version="1.2.0",\
    org.osgi.util.tracker;version="1.5.1",\
    org.slf4j;version="1.6.4",\
    *
Export-Package: \
    org.eclipse.kura.test.annotation;version="6.0.0"
-includeresource: \
    about.html,\
    about_files=about_files/
