Bundle-SymbolicName: ${project.artifactId};singleton:=true
Import-Package: \
    org.eclipse.kura.channel;version="1.2.0",\
    org.eclipse.kura.channel.listener;version="1.0.0",\
    org.eclipse.kura.configuration;version="1.2.0",\
    org.eclipse.kura.configuration.metatype;version="1.1.0",\
    org.eclipse.kura.core.configuration.metatype;version="1.0.0",\
    org.eclipse.kura.driver,\
    org.slf4j;version="1.7.32",\
    *
Bundle-Name: org.eclipse.kura.util.test.driver
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy
-includeresource: \
    about.html,\
    about_files=about_files/
