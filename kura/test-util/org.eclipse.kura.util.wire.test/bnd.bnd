Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Name: Wire Component test utilities
Bundle-Vendor: EUROTECH
Bundle-ActivationPolicy: lazy
Import-Package: \
    org.eclipse.kura;version="[1.5,2.0)",\
    org.eclipse.kura.configuration;version="[1.1,2.0)",\
    org.eclipse.kura.configuration.metatype;version="[1.1,2.0)",\
    org.eclipse.kura.type;version="1.1.0",\
    org.eclipse.kura.util.wire.test;version="1.1.0",\
    org.eclipse.kura.wire;version="[2.0,3.0)",\
    org.eclipse.kura.wire.graph;version="1.0.0",\
    org.osgi.framework;version="1.8.0",\
    org.osgi.service.component;version="1.3.0",\
    org.osgi.service.wireadmin;version="1.0.1",\
    org.osgi.util.tracker;version="1.5.0",\
    org.slf4j;version="1.7.25",\
    *
Export-Package: \
    org.eclipse.kura.util.wire.test;version="6.0.0"
-includeresource: \
    about.html,\
    about_files=about_files/
