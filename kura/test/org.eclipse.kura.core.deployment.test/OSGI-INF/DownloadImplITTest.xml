<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.3.0"
    name="org.eclipse.kura.core.deployment.download.impl.test.DownloadImplITTest"
    immediate="true">

    <reference name="ConfigurationService"
        interface="org.eclipse.kura.configuration.ConfigurationService"
        bind="setConfigurationService" />
    <reference name="CryptoService"
        interface="org.eclipse.kura.crypto.CryptoService"
        bind="setCryptoService" />
    <reference name="HttpServerManager"
        interface="org.eclipse.kura.configuration.ConfigurableComponent"
        target="(kura.service.pid=org.eclipse.kura.http.server.manager.HttpService)"
        bind="setHttpServerManager" />
    <reference name="RestService"
        interface="org.eclipse.kura.configuration.ConfigurableComponent"
        target="(kura.service.pid=org.eclipse.kura.internal.rest.provider.RestService)"
        bind="setRestService" />
    <reference name="SslManagerService"
        interface="org.eclipse.kura.ssl.SslManagerService"
        bind="setSslManagerService" />
    <implementation
        class="org.eclipse.kura.core.deployment.download.impl.test.DownloadImplITTest" />
</scr:component>