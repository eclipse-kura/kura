<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.eclipse.kura</groupId>
		<artifactId>target-platform</artifactId>
		<version>6.0.0-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>

	<artifactId>org.eclipse.kura.camel.sun.misc</artifactId>
	<version>2.0.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>Camel :: Core :: Import sun.misc</name>

	<build>
		<plugins>
			<!-- Metadata-only fragment for camel-core: imports sun.misc on its
				behalf, there are no classes in this jar, so the manifest is
				written directly instead of being computed by bnd. -->
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<forceCreation>true</forceCreation>
					<archive combine.self="override">
						<manifestEntries>
							<Bundle-ManifestVersion>2</Bundle-ManifestVersion>
							<Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
							<Bundle-Name>${project.name}</Bundle-Name>
							<Bundle-Version>2.0.0.SNAPSHOT</Bundle-Version>
							<Bundle-Vendor>Eclipse Kura</Bundle-Vendor>
							<Fragment-Host>org.apache.camel.camel-core;bundle-version="[2.16.0,2.26.0)"</Fragment-Host>
							<Import-Package>sun.misc</Import-Package>
							<Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=21))"</Require-Capability>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
