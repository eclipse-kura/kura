# Pull in the shared run configuration (framework, EE, runproperties, etc.)
-include: ${.}/../integration-test.bnd

# Kura emulator runtime (bundles this test needs available for resolution)
-runrequires.emulator: \
    osgi.identity;filter:='(osgi.identity=org.eclipse.kura.test)',\
    osgi.identity;filter:='(osgi.identity=org.eclipse.kura.util.wire.test)'
# Test bundle and its host
-runrequires: \
    osgi.identity;filter:='(osgi.identity=org.eclipse.kura.cloudconnection.kapua.mqtt.provider)'

#
# Runbundles populated by the bnd resolver
# (mvn verify -Presolve-integration-tests)
#
-runbundles: \
	bcpkix;version='1.84.0',\
	bcprov;version='1.84.0',\
	bcutil;version='1.84.0',\
	com.google.gson;version='2.9.0',\
	com.google.guava;version='32.1.1',\
	com.google.guava.failureaccess;version='1.0.1',\
	com.google.protobuf;version='4.30.2',\
	com.h2database;version='2.4.240',\
	io.netty.buffer;version='4.1.132',\
